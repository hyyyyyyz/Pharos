# Copy to `.env` and fill in. NEVER commit the real .env.
#
# LLM providers are named, and each task picks one. Every provider speaks the
# OpenAI wire format, so a self-hosted relay/gateway is configured exactly like
# a first-party endpoint — only PHAROS_*_BASE_URL differs.

# --- which provider serves which task ---------------------------------------
# Translation is high-volume, so it defaults to the free keyless engine.
#   bing | google              free, no key, weaker on academic prose
#   deepseek | openai | custom use the matching provider block below
PHAROS_TRANSLATOR_TYPE=bing
# The 领航 chat. Name a provider that actually holds a key, or chat returns a
# clear "not configured" error instead of pretending to answer.
PHAROS_CHAT_PROVIDER=deepseek

# --- provider: DeepSeek ------------------------------------------------------
PHAROS_DEEPSEEK_API_KEY=
PHAROS_DEEPSEEK_BASE_URL=https://api.deepseek.com
PHAROS_DEEPSEEK_MODEL=deepseek-chat

# --- provider: OpenAI, or any OpenAI-compatible relay ------------------------
# For a self-hosted gateway, set BASE_URL to it (keep the /v1 suffix if your
# relay expects one) and MODEL to whatever name that relay exposes.
PHAROS_OPENAI_API_KEY=
PHAROS_OPENAI_BASE_URL=https://api.openai.com/v1
PHAROS_OPENAI_MODEL=gpt-4o

# --- provider: anything else -------------------------------------------------
# Escape hatch for a vendor with no dedicated block; needs no code change.
PHAROS_CUSTOM_API_KEY=
PHAROS_CUSTOM_BASE_URL=
PHAROS_CUSTOM_MODEL=

# Conda env holding the BabelDOC engine (see scripts/setup_engine_env.sh)
PHAROS_ENGINE_CONDA_ENV=pharos-engine

# Optional: HuggingFace mirror for model/font downloads (CN / air-gapped)
# HF_ENDPOINT=https://hf-mirror.com

# --- deprecated --------------------------------------------------------------
# The old single-provider settings still work, but only for the provider named
# by PHAROS_TRANSLATOR_TYPE. Prefer the named blocks above.
# PHAROS_LLM_BASE_URL=
# PHAROS_LLM_API_KEY=
# PHAROS_LLM_MODEL=
