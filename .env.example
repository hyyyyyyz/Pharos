# Copy to `.env` and fill in. NEVER commit the real .env.
#
# LLM providers are named, and each task picks one. Every provider speaks the
# OpenAI wire format, so a self-hosted relay/gateway is configured exactly like
# a first-party endpoint — only PHAROS_*_BASE_URL differs.

# --- core runtime ------------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Localhost development can use an ephemeral key, but a stable/networked
# instance must set at least 32 random characters here.
PHAROS_AUTH_SECRET=

# Keep "*" only for local development. A deployed API should list its actual
# frontend origins, separated by commas.
PHAROS_CORS_ORIGINS=*
PHAROS_ALLOW_REGISTRATION=true

# Stable encryption key for third-party bearer credentials stored in SQLite.
# Generate independently from PHAROS_AUTH_SECRET with the same command above.
# Existing installations may omit it initially and keep manual Zotero keys in
# their legacy form. Do not rotate it without first setting the old value as
# PHAROS_CREDENTIAL_SECRET_PREVIOUS for one successful boot.
PHAROS_CREDENTIAL_SECRET=
# PHAROS_CREDENTIAL_SECRET_PREVIOUS=

# --- Zotero one-click authorization -----------------------------------------
# Register Pharos at https://www.zotero.org/oauth/apps with:
#   Website:  https://pharos.selab.top/
#   Callback: https://pharos.selab.top/api/zotero/oauth/callback
# Leave these empty to keep the manual User ID + API Key connection fallback.
PHAROS_ZOTERO_OAUTH_CLIENT_KEY=
PHAROS_ZOTERO_OAUTH_CLIENT_SECRET=
PHAROS_ZOTERO_OAUTH_CALLBACK_URL=https://pharos.selab.top/api/zotero/oauth/callback
PHAROS_ZOTERO_OAUTH_RETURN_URL=https://pharos.selab.top/

# Optional compiled Vite directory. Leave unset while using the Vite dev
# server; the production image sets this to /app/frontend automatically.
# PHAROS_WEB_DIR=/absolute/path/to/frontend/dist

# --- which provider serves which task ---------------------------------------
# Translation is high-volume, so it defaults to the free keyless engine.
#   bing | google              free, no key, weaker on academic prose
#   deepseek | openai | custom use the matching provider block below
PHAROS_TRANSLATOR_TYPE=bing
# Optional model-backed reading tasks (Daily Papers and Literature Discovery)
# use this provider. It is also reserved for the future Navigator chat backend.
# Leave the provider without a usable key to keep those readings disabled.
PHAROS_CHAT_PROVIDER=deepseek

# --- provider: DeepSeek ------------------------------------------------------
PHAROS_DEEPSEEK_API_KEY=
PHAROS_DEEPSEEK_BASE_URL=https://api.deepseek.com
PHAROS_DEEPSEEK_MODEL=deepseek-chat

# --- provider: OpenAI, or any OpenAI-compatible relay ------------------------
# For a self-hosted gateway, set BASE_URL to it (keep the /v1 suffix if your
# relay expects one) and MODEL to whatever name that relay exposes.
PHAROS_OPENAI_API_KEY=
PHAROS_OPENAI_BASE_URL=https://api.openai.com/v1
PHAROS_OPENAI_MODEL=gpt-4o

# --- provider: anything else -------------------------------------------------
# Escape hatch for a vendor with no dedicated block; needs no code change.
PHAROS_CUSTOM_API_KEY=
PHAROS_CUSTOM_BASE_URL=
PHAROS_CUSTOM_MODEL=

# Python interpreter inside the isolated BabelDOC engine environment. The
# built-in default is ~/miniconda3/envs/pharos-engine/bin/python. Uncomment
# this when conda or the environment lives somewhere else.
# PHAROS_ENGINE_PYTHON=/absolute/path/to/pharos-engine/bin/python

# Optional: HuggingFace mirror for model/font downloads (CN / air-gapped)
# HF_ENDPOINT=https://hf-mirror.com

# --- desktop updates ---------------------------------------------------------
# The desktop client asks GET /api/updates/desktop/latest for the newest build.
# When PHAROS_DESKTOP_UPDATE_VERSION_OVERRIDE is set (e.g. "1.4.0"), that exact
# version is advertised. When it is empty, the endpoint falls back to the newest
# desktop-v* release tag on GitHub and caches the answer for an hour. GitHub is
# where desktop-v* tags publish their installers, so in practice this needs no
# configuration; the override exists for staged or offline rollouts.
# PHAROS_DESKTOP_UPDATE_VERSION_OVERRIDE=1.4.0
# PHAROS_DESKTOP_UPDATE_REPO=hyyyyyyz/Pharos
# For a private repository the anonymous GitHub releases API answers 404, so
# the automatic fallback needs a fine-grained read-only token on Releases.
# PHAROS_DESKTOP_UPDATE_GITHUB_TOKEN=github_pat_...

# --- deprecated --------------------------------------------------------------
# The old single-provider settings still work, but only for the provider named
# by PHAROS_TRANSLATOR_TYPE. Prefer the named blocks above.
# PHAROS_LLM_BASE_URL=
# PHAROS_LLM_API_KEY=
# PHAROS_LLM_MODEL=
