# Copy to `.env` and fill in. NEVER commit the real .env.
# Translation backend — any OpenAI-compatible endpoint.
PHAROS_LLM_BASE_URL=https://api.deepseek.com/v1
PHAROS_LLM_API_KEY=
PHAROS_LLM_MODEL=deepseek-chat

# Conda env holding the BabelDOC engine (see scripts/setup_engine_env.sh)
PHAROS_ENGINE_CONDA_ENV=pharos-engine

# Optional: HuggingFace mirror for model/font downloads (CN / air-gapped)
# HF_ENDPOINT=https://hf-mirror.com
