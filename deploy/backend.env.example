# This file documents production settings only. The real file is generated at
# /home/winbeau/pharos/shared/secrets/backend.env with mode 0600 and is never
# copied into the repository or image.
PHAROS_AUTH_SECRET=generate-at-least-32-random-characters
PHAROS_CREDENTIAL_SECRET=generate-an-independent-stable-random-secret
PHAROS_ZOTERO_OAUTH_CLIENT_KEY=
PHAROS_ZOTERO_OAUTH_CLIENT_SECRET=
PHAROS_ZOTERO_OAUTH_CALLBACK_URL=https://pharos.selab.top/api/zotero/oauth/callback
PHAROS_ZOTERO_OAUTH_RETURN_URL=https://pharos.selab.top/
PHAROS_CORS_ORIGINS=https://hyyyyyyz.github.io,tauri://localhost,http://tauri.localhost
PHAROS_ALLOW_REGISTRATION=true
PHAROS_TRANSLATOR_TYPE=bing
PHAROS_CHAT_PROVIDER=
PHAROS_MAX_CONCURRENT_JOBS=1
PHAROS_QPS=2
PHAROS_DAILY_ENABLED=true

# Desktop update advertisement. Unset means "follow the newest desktop-v* tag
# on GitHub". Pin it to stage a rollout or when GitHub is unreachable.
# PHAROS_DESKTOP_UPDATE_VERSION_OVERRIDE=1.4.0

# Optional OpenAI-compatible relay. Keep credentials only in the server file.
# PHAROS_OPENAI_API_KEY=
# PHAROS_OPENAI_BASE_URL=https://api.example.com/v1
# PHAROS_OPENAI_MODEL=gpt-4o-mini
