# Pharos: the four binaries these rules used to cover (updater and launcher
# archives, 1.1M in total) are stored as ordinary blobs. This is a detached
# copy with no upstream LFS server to pull from, so an LFS pointer here is a
# file nobody can fetch -- a fresh clone would get pointers and the build
# would stop at check_lfs_file.
*.sql text eol=lf
