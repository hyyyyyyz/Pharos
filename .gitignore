# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
# Listed rather than matched at any depth, for the same reason: the client
# vendors pdf.js, which ships real sources under external/dist.
/dist/
site/dist/
zotero-connector/dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Environments & secrets (NEVER commit API keys) ---
.env
.env.*
!.env.example
# Desktop's public API origin is build configuration, not a secret. Tracking it
# keeps local and CI installers pointed at the same deployed Pharos service.
!frontend/.env.desktop

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
*.local

# --- Pharos runtime data (never commit user papers / DB / caches) ---
backend/storage/files/
# Anchored. Unanchored, this also matched client/chrome/content/zotero/xpcom/data/
# -- the desktop client's entire data model -- and every test fixture under
# client/test/tests/data. Those files are committed, so they were not lost, but
# any later edit to them would have been skipped by git add without a word.
/data/
*.db
*.sqlite3
*.sqlite3-*

# --- Model / HuggingFace / offline caches ---
.cache/
offline_assets/
*.onnx
# The client's PDF structure analysis ships three of these; they are part of
# the program, not build output.
!client/**/*.onnx

# --- macOS / editors ---
.DS_Store
.idea/
.vscode/
*.swp

# --- TypeScript incremental build artifacts ---
*.tsbuildinfo
node_modules/.tmp/

# --- image-generation scratch (curated brand assets live in assets/brand/) ---
output/

# --- stray agent worktrees ---
**/.claude/worktrees/
backend/.claude/

# --- Tauri desktop (build artifacts & generated files) ---
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/gen/
# `tauri icon` emits mobile-only assets too; the current desktop bundle does
# not consume them. Keep the curated macOS/Windows icon set tracked above them.
desktop/src-tauri/icons/android/
desktop/src-tauri/icons/ios/
desktop/src-tauri/icons/64x64.png
